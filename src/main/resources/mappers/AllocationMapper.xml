<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jules.ipam.dao.AllocationDAO">

    <insert id="insertAllocation" parameterType="com.jules.ipam.vo.AllocationVO">
        INSERT INTO allocation (ip_id, user_id, purpose, allocated_at)
        VALUES (#{ipId}, #{userId}, #{purpose}, NOW())
    </insert>

    <delete id="deleteAllocationByIpId" parameterType="int">
        DELETE FROM allocation WHERE ip_id = #{ipId}
    </delete>

</mapper>
